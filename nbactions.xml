<?xml version="1.0" encoding="UTF-8"?>
<actions>

    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.6.3:java</goal>
        </goals>
        <properties>
            <exec.mainClass>com.redes.udp.Lanzador</exec.mainClass>
        </properties>
    </action>

    <action>
        <actionName>run.single.main</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.6.3:java</goal>
        </goals>
        <properties>
            <exec.mainClass>${packageClassName}</exec.mainClass>
        </properties>
    </action>
</actions>
